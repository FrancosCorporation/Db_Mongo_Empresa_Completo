# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=db_mongo_empresa_completo
JWT_AUDIENCE=db_mongo_empresa_completo

# Local: o Compose substitui localhost pelo serviço mongo.
MONGO_URI=mongodb://localhost:27017/db_mongo_empresa_completo

# Preencha para habilitar uploads de fotos.
CLOUDINARY_USER=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Origens web autorizadas, separadas por vírgula. Vazio mantém CORS fechado.
CORS_ORIGINS=
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=0
